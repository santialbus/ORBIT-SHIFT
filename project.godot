; Engine configuration file.
; ORBIT SHIFT - Godot 4.3 project

config_version=5

[application]

config/name="ORBIT SHIFT"
config/description="Neon sci-fi arcade: one finger, three orbits, one mistake."
config/version="0.9.0-beta"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.0196, 0.0392, 0.0941, 1)
boot_splash/show_image=false
config/icon="res://assets/icons/icon.png"

[autoload]

SaveManager="*res://scripts/save/save_manager.gd"
GameStateManager="*res://scripts/core/game_state_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
SkinManager="*res://scripts/progression/skin_manager.gd"
ProgressionManager="*res://scripts/progression/progression_manager.gd"
MissionManager="*res://scripts/missions/mission_manager.gd"
AchievementManager="*res://scripts/achievements/achievement_manager.gd"
UIManager="*res://scripts/ui/ui_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.0196, 0.0392, 0.0941, 1)
